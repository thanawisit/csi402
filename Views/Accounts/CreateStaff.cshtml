@model CreateStaffAccountViewModel
@{
    ViewData["Title"] = "สร้างบัญชี Staff";
}

<style>
    .create-account-page {
        max-width: 760px;
        margin: 0 auto;
        padding: 2rem 1rem 3rem;
    }

    .create-account-card {
        overflow: hidden;
        border: 1px solid #dde5d9;
        border-radius: 22px;
        background: #fffef9;
        box-shadow: 0 16px 38px rgba(58, 76, 61, .10);
    }

    .create-account-header {
        border-bottom: 1px solid #edf0e9;
        background:
            radial-gradient(circle at 90% 10%, rgba(47, 107, 59, .10), transparent 11rem),
            linear-gradient(135deg, #f8faf5 0%, #edf3e8 100%);
        padding: 1.25rem 1.35rem;
    }

    .create-account-header h1 {
        margin: .5rem 0 .25rem;
        font-size: 1.55rem;
        font-weight: 850;
    }

    .create-account-form {
        padding: 1.35rem;
    }

    .create-account-form .form-control,
    .create-account-form .form-select {
        min-height: 46px;
        border-color: #dce4da;
        background: #fffefb;
    }

    .create-account-role-note {
        border: 1px solid #dfe8db;
        border-radius: 13px;
        background: #f3f7ef;
        color: #657066;
        padding: .75rem;
    }
</style>

<div class="create-account-page">
    <div class="create-account-card">
        <header class="create-account-header">
            <span class="badge rounded-pill bg-success-subtle text-success">ADMIN ONLY</span>
            <h1>สร้างบัญชี Staff</h1>
            <p class="text-muted mb-0">กำหนดข้อมูลเข้าสู่ระบบและสิทธิ์พนักงาน</p>
        </header>
        <div class="create-account-form">

                    <form asp-action="CreateStaff" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Username" class="form-label fw-semibold"></label>
                            <input asp-for="Username" class="form-control" autocomplete="name" />
                            <span asp-validation-for="Username" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold"></label>
                            <input asp-for="Email" class="form-control" autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PhoneNumber" class="form-label fw-semibold"></label>
                            <input asp-for="PhoneNumber" class="form-control" autocomplete="tel" />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Role" class="form-label fw-semibold"></label>
                            <select asp-for="Role" class="form-select">
                                <option value="@AppRoles.Staff">พนักงาน (Staff)</option>
                            </select>
                            <span asp-validation-for="Role" class="text-danger"></span>
                            <div class="create-account-role-note mt-2 small">
                                <i class="bi bi-check2-circle me-1 text-success" aria-hidden="true"></i>
                                Staff ดูแลการจอง การชำระเงิน ออเดอร์ครัว และสต๊อก
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-semibold"></label>
                            <input asp-for="Password" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                            <div class="form-text">ใช้รหัสผ่านอย่างน้อย 8 ตัวอักษร</div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success">สร้างบัญชี Staff</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">ยกเลิก</a>
                        </div>
                    </form>
                </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
