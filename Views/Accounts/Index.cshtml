@model IEnumerable<AdminUserListItemViewModel>
@{
    ViewData["Title"] = "จัดการบัญชีและบทบาท";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <span class="badge rounded-pill bg-danger-subtle text-danger mb-2">ACCOUNT MANAGEMENT</span>
            <h1 class="fw-bold mb-1">จัดการบัญชีและบทบาท</h1>
            <p class="text-muted mb-0">กำหนดสิทธิ์การใช้งานของบัญชีในระบบ</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="CreateStaff" class="btn btn-success rounded-3">
                <i class="bi bi-person-plus me-2"></i>สร้างบัญชี Staff
            </a>
            <a asp-action="CreateManager" class="btn btn-danger rounded-3">
                <i class="bi bi-person-plus me-2"></i>สร้างบัญชี Manager
            </a>
            <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary rounded-3">
                <i class="bi bi-arrow-left me-2"></i>กลับหน้าระบบหลังบ้าน
            </a>
        </div>
    </div>

    @if (TempData["AdminMessage"] != null)
    {
        <div class="alert alert-success">@TempData["AdminMessage"]</div>
    }
    @if (TempData["AdminError"] != null)
    {
        <div class="alert alert-danger">@TempData["AdminError"]</div>
    }

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white border-0 px-4 pt-4">
            <h2 class="h5 fw-bold mb-1">บัญชีผู้ใช้</h2>
            <p class="small text-muted mb-0">เพื่อความปลอดภัย ไม่สามารถเปลี่ยนบทบาทบัญชีที่กำลังเข้าสู่ระบบได้</p>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">ชื่อผู้ใช้</th>
                        <th>อีเมล</th>
                        <th>โทรศัพท์</th>
                        <th>บทบาท</th>
                        <th class="text-end pe-4">บันทึก</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var account in Model)
                    {
                        var isCurrentAccount = string.Equals(
                            account.Email,
                            User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value,
                            StringComparison.OrdinalIgnoreCase);
                        <tr>
                            <td class="ps-4 fw-semibold">@account.Username</td>
                            <td>@account.Email</td>
                            <td>@(account.PhoneNumber ?? "-")</td>
                            <td>
                                <form asp-action="UpdateRole" method="post" id="role-@account.UserId" class="d-flex gap-2">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@account.UserId" />
                                    <select name="role" class="form-select form-select-sm" aria-label="บทบาทของ @account.Username" disabled="@isCurrentAccount">
                                        @foreach (var role in AppRoles.Labels)
                                        {
                                            <option value="@role.Key" selected="@(role.Key == account.Role)">@role.Value</option>
                                        }
                                    </select>
                                </form>
                            </td>
                            <td class="text-end pe-4">
                                <button type="submit" form="role-@account.UserId" class="btn btn-sm btn-outline-success" disabled="@isCurrentAccount">
                                    <i class="bi bi-check2 me-1"></i>บันทึกบทบาท
                                </button>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-5">ยังไม่มีบัญชีผู้ใช้</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
