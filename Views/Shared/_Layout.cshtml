<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IsanDer</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- เพิ่ม Bootstrap Icons สำหรับไอคอนรถเข็นและผู้ใช้งาน -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/IsanDer.styles.css" asp-append-version="true" />
    
    <style>
        /* ตกแต่ง Navbar ให้เหมือนในรูป */
        .navbar-brand-custom {
            color: #bd3124 !important; /* สีแดงแบรนด์ */
            font-weight: 800;
            font-size: 1.5rem;
        }
        .nav-link-custom {
            color: #333 !important;
            font-weight: 600;
            margin: 0 10px;
        }
        .nav-link-custom:hover {
            color: #bd3124 !important;
        }
        .nav-icon {
            color: #555;
            margin-left: 20px;
            text-decoration: none;
            transition: 0.2s;
        }
        .nav-icon:hover {
            color: #bd3124;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3 py-3">
            <div class="container">
                
                <!-- 1. โลโก้ (ฝั่งซ้าย) -->
                <a class="navbar-brand navbar-brand-custom" asp-area="" asp-controller="Home" asp-action="Index">อีสาน เด้อ</a>
                
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    
                    <!-- 2. เมนูหลัก (จัดให้อยู่ตรงกลางด้วย mx-auto) -->
                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-area="" asp-controller="Home" asp-action="Index">หน้าแรก</a>
                        </li>
                        <li class="nav-item">
                          <a class="nav-link nav-link-custom" asp-area="" asp-controller="Home" asp-action="Menu">เมนู</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-area="" asp-controller="Home" asp-action="Buffet">บุฟเฟต์</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" href="#">สั่งล่วงหน้า</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-area="" asp-controller="Home" asp-action="Contact">ติดต่อเรา</a>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-area="" asp-controller="Home" asp-action="OrderHistory">ประวัติการสั่งซื้อ</a>
                        </li>
                    </ul>

                    <!-- 3. ไอคอนรถเข็น และ โปรไฟล์ผู้ใช้งาน (ฝั่งขวา) -->
                    <div class="d-flex align-items-center">
                        <a asp-controller="Home" asp-action="Cart" class="nav-icon fs-5">
                            <i class="bi bi-cart2"></i>
                        </a>
                        <!-- ลิงก์ไอคอนโปรไฟล์ไปที่หน้า Login -->
                        <a asp-controller="Account" asp-action="Login" class="nav-icon fs-4">
                            <i class="bi bi-person-fill"></i>
                        </a>
                    </div>

                </div>
            </div>
        </nav>
    </header>
    
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-5">
        <div class="container">
            &copy; 2026 - IsanDer - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>