@{
    var isAdmin = User.IsInRole(AppRoles.Admin);
    var isManager = User.IsInRole(AppRoles.Manager);
    var isStaff = User.IsInRole(AppRoles.Staff);
    var isAccountant = User.IsInRole(AppRoles.Accountant);
    var isBackOffice = isAdmin || isManager || isStaff || isAccountant;
    var canManageMenus = User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Manager);
    var canManageOrders = User.IsInRole(AppRoles.Admin) ||
                          User.IsInRole(AppRoles.Manager) ||
                          User.IsInRole(AppRoles.Staff) ||
                          User.IsInRole(AppRoles.Accountant);
    var canManageStock = User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Staff);
    var canManageUsers = canManageMenus;
    var canManagePromotions = canManageMenus;
    var canViewReports = canManageMenus || isAccountant;
    var canManageReviews = isAdmin || isManager;
    var roleName = isAdmin ? "ผู้ดูแลระบบ"
        : isManager ? "ผู้จัดการ"
        : isStaff ? "พนักงาน"
        : isAccountant ? "พนักงานบัญชี"
        : "ลูกค้า";
    var roleClass = isAdmin ? "admin"
        : isManager ? "manager"
        : isStaff ? "staff"
        : isAccountant ? "accountant"
        : "customer";
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - อีสาน เด้อ (IsanDer)</title>
    
    <!-- Google Fonts: Kanit (Headings) & Prompt (Body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Kanit:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400&family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/IsanDer.styles.css" asp-append-version="true" />
</head>
<body class="role-@roleClass">
    <header class="site-header">
        <!-- แถบลายผ้าขาวม้าอีสานเอกลักษณ์ (แดง ขาว) -->
        <div class="isan-stripe-bar"></div>

        <!-- แถบประกาศหัวเว็บด้านบน (Top Announcement Bar - ธีม แดงขาว) -->
        <div class="top-announcement-bar py-1 d-none d-md-block">
            <div class="container d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-3">
                    <span class="announcement-pill"><i class="bi bi-fire text-warning"></i> รสอีสานแท้ 100%</span>
                    <span class="announcement-text text-white-50">แซ่บนัวถึงใจ สด สะอาด ปรุงจานต่อจานทุกวัน</span>
                </div>
                <div class="d-flex align-items-center gap-4 text-white-50 small">
                    <span><i class="bi bi-clock-fill text-warning me-1"></i> เปิดบริการ 10:00 - 22:00 น.</span>
                    <span><i class="bi bi-telephone-fill text-white me-1"></i> 089-123-4567</span>
                    <span><i class="bi bi-geo-alt-fill text-warning me-1"></i> ขอนแก่น</span>
                </div>
            </div>
        </div>

        <!-- แถบเมนูหลัก Navbar (ธีม แดง ขาว) -->
        <nav class="navbar navbar-expand-lg navbar-dark sticky-top py-2 role-navbar role-navbar-@roleClass">
            <div class="container">
                <!-- โลโก้ร้าน (แบรนด์) -->
                <a class="navbar-brand navbar-brand-custom" asp-area="" asp-controller="@(isBackOffice ? "Admin" : "Home")" asp-action="@(isManager ? "Manager" : "Index")">
                    <span class="brand-mark shadow-sm"><i class="bi bi-fire"></i></span>
                    <div class="d-flex flex-column lh-1">
                        <span class="brand-title">อีสาน เด้อ</span>
                        <span class="brand-subtitle">ISAN DER RESTAURANT</span>
                    </div>
                    @if (isBackOffice)
                    {
                        <span class="role-badge role-badge-@roleClass ms-2">
                            <i class="bi bi-shield-check me-1"></i>@roleName
                        </span>
                    }
                </a>
                
                <button class="navbar-toggler border-0 shadow-none text-white" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMainContent" aria-controls="navbarMainContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="navbar-collapse collapse" id="navbarMainContent">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                        @if (isBackOffice)
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom" asp-controller="Admin" asp-action="@(User.IsInRole(AppRoles.Manager) ? "Manager" : "Index")">
                                    <i class="bi bi-speedometer2 me-1"></i>แดชบอร์ด
                                </a>
                            </li>
                            @if (canManageMenus)
                            {
                                <li class="nav-item">
                                    <a class="nav-link nav-link-custom" asp-controller="Admin" asp-action="Menus">จัดการเมนู</a>
                                </li>
                            }
                            @if (canManageOrders)
                            {
                                <li class="nav-item">
                                    <a class="nav-link nav-link-custom" asp-controller="Admin" asp-action="Orders">จัดการออเดอร์</a>
                                </li>
                            }
                            @if (canManageStock)
                            {
                                <li class="nav-item">
                                    <a class="nav-link nav-link-custom" asp-controller="Admin" asp-action="Stock">สต๊อก</a>
                                </li>
                            }
                            @if (canViewReports)
                            {
                                <li class="nav-item">
                                    <a class="nav-link nav-link-custom" asp-controller="Admin" asp-action="Reports">ยอดขาย</a>
                                </li>
                            }
                            @if (canManagePromotions)
                            {
                                <li class="nav-item">
                                    <a class="nav-link nav-link-custom" asp-controller="Admin" asp-action="Promotions">โปรโมชั่น</a>
                                </li>
                            }
                            @if (canManageReviews)
                            {
                                <li class="nav-item">
                                    <a class="nav-link nav-link-custom" asp-controller="Admin" asp-action="Reviews">
                                        รีวิวลูกค้า
                                    </a>
                                </li>
                            }
                            @if (canManageUsers)
                            {
                                <li class="nav-item">
                                    @if (User.IsInRole(AppRoles.Admin))
                                    {
                                        <a class="nav-link nav-link-custom" asp-controller="Accounts" asp-action="Index">บัญชีและบทบาท</a>
                                    }
                                    else
                                    {
                                        <a class="nav-link nav-link-custom" asp-controller="Admin" asp-action="Users">พนักงาน</a>
                                    }
                                </li>
                            }
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom" asp-area="" asp-controller="Home" asp-action="Index">
                                    หน้าแรก
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom" asp-area="" asp-controller="Home" asp-action="Menu">
                                    เมนูอาหาร
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom nav-link-highlight" asp-area="" asp-controller="Home" asp-action="Buffet">
                                    เลือกแพ็กเกจ
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom" asp-area="" asp-controller="Home" asp-action="Menu" title="เลือกอาหารล่วงหน้าและมารับที่ร้าน">
                                    สั่งล่วงหน้า
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom" asp-area="" asp-controller="Home" asp-action="Contact">
                                    ติดต่อเรา
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom" asp-area="" asp-controller="Home" asp-action="OrderHistory">
                                    ประวัติการสั่งซื้อ
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom" asp-area="" asp-controller="Home" asp-action="ReservationHistory">
                                    ประวัติการจองโต๊ะ
                                </a>
                            </li>
                        }
                    </ul>

                    <!-- ปุ่มควบคุมฝั่งขวา (ตะกร้า และ เข้าสู่ระบบ/โปรไฟล์) -->
                    <div class="d-flex align-items-center gap-2 mt-2 mt-lg-0">
                        @if (isBackOffice)
                        {
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-light btn-sm rounded-pill px-3 fw-bold">
                                <i class="bi bi-shop me-1"></i>หน้าร้าน
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Home" asp-action="Cart" asp-route-tableId="@ViewBag.TableId" class="nav-cart-btn" aria-label="ตะกร้าสินค้า">
                                <i class="bi bi-cart3 fs-5 text-danger"></i>
                                <span class="d-none d-sm-inline fw-bold ms-1 text-dark">ตะกร้า</span>
                                @await Component.InvokeAsync("CartCount")
                            </a>
                        }

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (!isBackOffice)
                            {
                                <a asp-controller="Home" asp-action="Profile" class="nav-user-btn" aria-label="โปรไฟล์">
                                    <i class="bi bi-person-fill fs-5"></i>
                                    <span class="d-none d-sm-inline fw-semibold ms-1">โปรไฟล์</span>
                                </a>
                            }
                            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                <button type="submit" class="btn btn-logout-custom btn-sm rounded-pill px-3" aria-label="ออกจากระบบ">
                                    <i class="bi bi-box-arrow-right me-1"></i> ออกจากระบบ
                                </button>
                            </form>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-login-custom rounded-pill px-3">
                                <i class="bi bi-person-circle me-1"></i> เข้าสู่ระบบ
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    
    <div class="main-wrapper">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <!-- ส่วนท้าย Footer (ธีม แดง ขาว) -->
    <footer class="site-footer mt-auto">
        <!-- แถบลายผ้าขาวม้าแดงขาวเหนือก่อนเข้า Footer -->
        <div class="isan-stripe-bar"></div>

        <div class="container py-5">
            <div class="row g-4 justify-content-between">
                <!-- คอลัมน์ 1: แบรนด์และคำแนะนำร้าน -->
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="brand-mark shadow-sm"><i class="bi bi-fire"></i></span>
                        <h4 class="brand-title text-white mb-0">อีสาน เด้อ</h4>
                    </div>
                    <p class="footer-desc text-white-50 mb-3">
                        สัมผัสรสชาติอีสานแท้ 100% สด สะอาด แซ่บนัวถึงใจ ปรุงจานต่อจานด้วยน้ำปลาร้าต้มสุกสูตรเด็ด เสิร์ฟพร้อมผักเคียงสดกรอบ อิ่มอร่อยได้ทั้งบุฟเฟต์ 299.- และอาลาคาสต์
                    </p>
                    <div class="d-flex gap-2">
                        <span class="badge bg-white text-danger px-3 py-2 rounded-pill fw-bold"><i class="bi bi-check2-circle me-1"></i> สะอาด ปลอดภัย</span>
                        <span class="badge bg-danger text-white border border-white border-opacity-25 px-3 py-2 rounded-pill fw-bold"><i class="bi bi-stars me-1"></i> อีสานแท้ 100%</span>
                    </div>
                </div>

                <!-- คอลัมน์ 2: ลิงก์ด่วน -->
                <div class="col-lg-2 col-md-6">
                    <h5 class="footer-heading text-white mb-3">เมนูและบริการ</h5>
                    <ul class="list-unstyled footer-links mb-0">
                        <li><a asp-controller="Home" asp-action="Index"><i class="bi bi-chevron-right text-warning me-1"></i>หน้าแรก</a></li>
                        <li><a asp-controller="Home" asp-action="Menu"><i class="bi bi-chevron-right text-warning me-1"></i>เมนูอาหาร</a></li>
                        <li><a asp-controller="Home" asp-action="Buffet"><i class="bi bi-chevron-right text-warning me-1"></i>แพ็กเกจบุฟเฟต์ 299</a></li>
                        <li><a asp-controller="Home" asp-action="Menu"><i class="bi bi-chevron-right text-warning me-1"></i>สั่งล่วงหน้า</a></li>
                        <li><a asp-controller="Home" asp-action="Contact"><i class="bi bi-chevron-right text-warning me-1"></i>ติดต่อเรา</a></li>
                    </ul>
                </div>

                <!-- คอลัมน์ 3: เวลาเปิดบริการ & ที่ตั้ง -->
                <div class="col-lg-3 col-md-6">
                    <h5 class="footer-heading text-white mb-3">เวลาเปิดบริการ</h5>
                    <div class="footer-card p-3 rounded-3 mb-3">
                        <div class="d-flex align-items-center text-white mb-2">
                            <i class="bi bi-clock-history text-warning fs-5 me-2"></i>
                            <div>
                                <strong class="d-block">จันทร์ - อาทิตย์</strong>
                                <small class="text-white-50">10:00 น. - 22:00 น.</small>
                            </div>
                        </div>
                        <div class="text-warning small"><i class="bi bi-check-circle-fill me-1"></i> เปิดให้บริการทุกวันไม่มีวันหยุด</div>
                    </div>
                    <div class="text-white-50 small">
                        <i class="bi bi-geo-alt-fill text-warning me-1"></i> 123 ถนนมิตรภาพ อ.เมือง จ.ขอนแก่น
                    </div>
                </div>

                <!-- คอลัมน์ 4: ช่องทางการติดต่อ -->
                <div class="col-lg-3 col-md-6">
                    <h5 class="footer-heading text-white mb-3">ช่องทางติดต่อ</h5>
                    <div class="d-flex flex-column gap-2 mb-3">
                        <a href="tel:0891234567" class="footer-contact-link">
                            <i class="bi bi-telephone-fill text-warning"></i> 089-123-4567
                        </a>
                        <a href="https://line.me" target="_blank" rel="noopener noreferrer" class="footer-contact-link">
                            <i class="bi bi-line text-white"></i> LINE: @@IsanDer
                        </a>
                        <a href="mailto:support@isander.com" class="footer-contact-link">
                            <i class="bi bi-envelope-fill text-warning"></i> support@isander.com
                        </a>
                    </div>
                    <div class="footer-badges d-flex gap-2">
                        <span class="social-icon-btn"><i class="bi bi-facebook"></i></span>
                        <span class="social-icon-btn"><i class="bi bi-instagram"></i></span>
                        <span class="social-icon-btn"><i class="bi bi-tiktok"></i></span>
                    </div>
                </div>
            </div>

            <!-- ลิขสิทธิ์และนโยบายด้านล่าง -->
            <div class="footer-bottom border-top border-white border-opacity-10 pt-4 mt-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div class="text-white-50 small">
                    &copy; 2026 <strong>อีสาน เด้อ (IsanDer)</strong> - สงวนลิขสิทธิ์ทุกประการ
                </div>
                <div class="small">
                    <a asp-area="" asp-controller="Home" asp-action="Privacy" class="footer-sublink me-3">นโยบายความเป็นส่วนตัว</a>
                    <a asp-area="" asp-controller="Home" asp-action="Terms" class="footer-sublink">ข้อกำหนดการใช้บริการ</a>
                </div>
            </div>
        </div>
    </footer>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
