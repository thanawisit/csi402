@{
    var isStaff = User.IsInRole(AppRoles.Admin) ||
                  User.IsInRole(AppRoles.Manager) ||
                  User.IsInRole(AppRoles.Receptionist) ||
                  User.IsInRole(AppRoles.Chef) ||
                  User.IsInRole(AppRoles.StockChecker);
    var canManageMenus = User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Manager);
    var canManageOrders = User.IsInRole(AppRoles.Admin) ||
                          User.IsInRole(AppRoles.Receptionist) ||
                          User.IsInRole(AppRoles.Chef);
    var canManageStock = User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.StockChecker);
    var canManageUsers = canManageMenus;
    var canViewReports = canManageMenus;
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IsanDer</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- เพิ่ม Bootstrap Icons สำหรับไอคอนรถเข็นและผู้ใช้งาน -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/IsanDer.styles.css" asp-append-version="true" />
    
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3 py-3">
            <div class="container">
                
                <!-- 1. โลโก้ (ฝั่งซ้าย) -->
                <a class="navbar-brand navbar-brand-custom" asp-area="" asp-controller="@(isStaff ? "Admin" : "Home")" asp-action="@(User.IsInRole(AppRoles.Manager) ? "Manager" : "Index")">
                    <span class="brand-mark"><i class="bi bi-fire"></i></span>
                    <span>อีสาน เด้อ</span>
                    @if (isStaff)
                    {
                        <span class="badge rounded-pill bg-warning text-dark ms-1">ระบบหลังบ้าน</span>
                    }
                </a>
                
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    
                    <ul class="navbar-nav mx-auto">
                        @if (isStaff)
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom" asp-controller="Admin" asp-action="@(User.IsInRole(AppRoles.Manager) ? "Manager" : "Index")">แดชบอร์ด</a>
                            </li>
                            @if (canManageMenus)
                            {
                                <li class="nav-item">
                                    <a class="nav-link nav-link-custom" asp-controller="Admin" asp-action="Menus">จัดการเมนู</a>
                                </li>
                            }
                            @if (canManageOrders)
                            {
                                <li class="nav-item">
                                    <a class="nav-link nav-link-custom" asp-controller="Admin" asp-action="Orders">จัดการออเดอร์</a>
                                </li>
                            }
                            @if (canManageStock)
                            {
                                <li class="nav-item">
                                    <a class="nav-link nav-link-custom" asp-controller="Admin" asp-action="Stock">สต๊อก</a>
                                </li>
                            }
                            @if (canViewReports)
                            {
                                <li class="nav-item">
                                    <a class="nav-link nav-link-custom" asp-controller="Admin" asp-action="Reports">ยอดขาย</a>
                                </li>
                            }
                            @if (canManageUsers)
                            {
                                <li class="nav-item">
                                    <a class="nav-link nav-link-custom" asp-controller="Admin" asp-action="Users">
                                        @(User.IsInRole(AppRoles.Manager) ? "พนักงาน" : "ผู้ใช้")
                                    </a>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom" asp-area="" asp-controller="Home" asp-action="Index">หน้าแรก</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom" asp-area="" asp-controller="Home" asp-action="Menu">เมนู</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom" asp-area="" asp-controller="Home" asp-action="Buffet">บุฟเฟต์</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom" asp-area="" asp-controller="Home" asp-action="Menu" title="เลือกอาหารล่วงหน้าและมารับที่ร้าน">สั่งล่วงหน้า</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom" asp-area="" asp-controller="Home" asp-action="Contact">ติดต่อเรา</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom" asp-area="" asp-controller="Home" asp-action="OrderHistory">ประวัติการสั่งซื้อ</a>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center">
                        @if (isStaff)
                        {
                            <a asp-controller="Home" asp-action="Index" class="nav-link nav-link-custom">หน้าร้าน</a>
                        }
                        else
                        {
                            <a asp-controller="Home" asp-action="Cart" class="nav-icon fs-5" aria-label="ตะกร้าสินค้า">
                                <i class="bi bi-cart2"></i>
                            </a>
                        }

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (!isStaff)
                            {
                                <a asp-controller="Home" asp-action="Profile" class="nav-icon fs-4" aria-label="โปรไฟล์">
                                    <i class="bi bi-person-fill"></i>
                                </a>
                            }
                            <form asp-controller="Account" asp-action="Logout" method="post" class="ms-3">
                                <button type="submit" class="btn btn-link nav-icon text-decoration-none p-0" aria-label="ออกจากระบบ">
                                    <i class="bi bi-box-arrow-right"></i> ออกจากระบบ
                                </button>
                            </form>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="nav-icon text-decoration-none">เข้าสู่ระบบ</a>
                        }
                        
                    </div>

                </div>
            </div>
        </nav>
    </header>
    
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-5">
        <div class="container">
            @if (isStaff)
            {
                <span>&copy; 2026 - IsanDer - ระบบจัดการร้าน</span>
            }
            else
            {
                <span>&copy; 2026 - IsanDer - </span>
                <a asp-area="" asp-controller="Home" asp-action="Privacy">นโยบายความเป็นส่วนตัว</a>
                <span class="mx-2">|</span>
                <a asp-area="" asp-controller="Home" asp-action="Terms">ข้อกำหนดการใช้บริการ</a>
            }
        </div>
    </footer>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>