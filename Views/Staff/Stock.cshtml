@model IEnumerable<StockMenuViewModel>
@{
    ViewData["Title"] = "ตรวจสอบสต๊อก";
}

<div class="container py-4">
    <h1 class="fw-bold mb-1">ตรวจสอบสต๊อก</h1>
    <p class="text-muted mb-4">ใส่จำนวนคงเหลือ หรือเว้นว่างหากยังไม่ติดตามจำนวนสต๊อก</p>

    @if (TempData["AdminMessage"] != null)
    {
        <div class="alert alert-success">@TempData["AdminMessage"]</div>
    }

    <div class="card border-0 shadow-sm rounded-4">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">เมนู</th>
                        <th>คงเหลือ</th>
                        <th>สถานะขาย</th>
                        <th class="text-end pe-4">บันทึก</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var menu in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold">@menu.MenuName</td>
                            <td>
                                <form asp-action="UpdateStock" method="post" id="stock-@menu.MenuId" class="d-flex gap-2 align-items-center">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@menu.MenuId" />
                                    <input type="number" name="stockQuantity" min="0" value="@menu.StockQuantity"
                                           class="form-control form-control-sm" style="max-width: 130px"
                                           placeholder="ไม่ติดตาม" aria-label="จำนวนคงเหลือ @menu.MenuName" />
                                </form>
                            </td>
                            <td>
                                <select name="status" form="stock-@menu.MenuId" class="form-select form-select-sm" style="max-width: 150px">
                                    <option value="Available" selected="@(menu.Status == "Available")">พร้อมขาย</option>
                                    <option value="Unavailable" selected="@(menu.Status == "Unavailable")">ปิดขาย</option>
                                </select>
                            </td>
                            <td class="text-end pe-4">
                                <button type="submit" form="stock-@menu.MenuId" class="btn btn-sm btn-success">บันทึก</button>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="4" class="text-center text-muted py-5">ยังไม่มีเมนูในระบบ</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
