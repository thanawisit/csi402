@model AdminDashboardViewModel
@{
    ViewData["Title"] = "แดชบอร์ดผู้จัดการ";
}

<style>
    .manager-dashboard-page {
        max-width: 1180px;
        margin: 0 auto;
        padding: 1.75rem 1.25rem 3rem;
    }

    .manager-dashboard-hero {
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        min-height: 176px;
        border: 1px solid rgba(255, 255, 255, .14);
        border-radius: 22px;
        background:
            radial-gradient(circle at 88% 15%, rgba(240, 161, 61, .20), transparent 12rem),
            linear-gradient(135deg, #173d2c 0%, #2f6b3b 58%, #5e7d50 100%);
        color: #fff;
        box-shadow: 0 18px 44px rgba(23, 61, 44, .16);
        padding: 1.65rem 1.75rem;
    }

    .manager-dashboard-hero::after {
        content: "";
        position: absolute;
        right: -58px;
        bottom: -96px;
        width: 230px;
        height: 230px;
        border: 30px solid rgba(255, 255, 255, .06);
        border-radius: 50%;
    }

    .manager-hero-copy {
        position: relative;
        z-index: 1;
    }

    .manager-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        border: 1px solid rgba(255, 255, 255, .18);
        border-radius: 999px;
        background: rgba(255, 255, 255, .09);
        color: #ffe2aa;
        padding: .32rem .68rem;
        font-size: .72rem;
        font-weight: 850;
        letter-spacing: .08em;
        text-transform: uppercase;
    }

    .manager-hero-copy h1 {
        margin: .7rem 0 .35rem;
        color: #fff;
        font-size: clamp(1.65rem, 4vw, 2.35rem);
        font-weight: 850;
        letter-spacing: -.02em;
    }

    .manager-hero-copy p {
        margin: 0;
        color: rgba(255, 255, 255, .72);
    }

    .manager-user-chip {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: .75rem;
        min-width: 210px;
        border: 1px solid rgba(255, 255, 255, .13);
        border-radius: 16px;
        background: rgba(255, 255, 255, .09);
        backdrop-filter: blur(8px);
        padding: .75rem;
    }

    .manager-user-icon {
        display: grid;
        width: 44px;
        height: 44px;
        flex: 0 0 44px;
        place-items: center;
        border-radius: 13px;
        background: #d7a91c;
        color: #173d2c;
        font-size: 1.05rem;
    }

    .manager-user-copy {
        display: grid;
        min-width: 0;
    }

    .manager-user-copy strong,
    .manager-user-copy span {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .manager-user-copy strong {
        font-size: .9rem;
    }

    .manager-user-copy span {
        color: rgba(255, 255, 255, .65);
        font-size: .72rem;
    }

    .manager-dashboard-section {
        margin-top: 1.25rem;
    }

    .manager-section-heading {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: .75rem;
    }

    .manager-section-heading h2 {
        margin: 0;
        font-size: 1.05rem;
        font-weight: 850;
    }

    .manager-section-heading span {
        color: #879087;
        font-size: .78rem;
    }

    .manager-stat-grid {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: .8rem;
    }

    .manager-stat-card {
        position: relative;
        grid-column: span 3;
        min-height: 132px;
        overflow: hidden;
        border: 1px solid #e4e8df;
        border-radius: 18px;
        background: #fffef9;
        box-shadow: 0 10px 26px rgba(58, 76, 61, .07);
        padding: 1.15rem;
    }

    .manager-stat-card.wide {
        grid-column: span 6;
    }

    .manager-stat-card::after {
        content: "";
        position: absolute;
        right: -34px;
        bottom: -48px;
        width: 112px;
        height: 112px;
        border: 16px solid rgba(47, 107, 59, .055);
        border-radius: 50%;
    }

    .manager-stat-card.alert {
        border-color: #edcf72;
        background: linear-gradient(135deg, #fffdf5 0%, #fff1bd 100%);
    }

    .manager-stat-card.alert::after {
        border-color: rgba(215, 169, 28, .10);
    }

    .manager-stat-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .75rem;
    }

    .manager-stat-label {
        color: #79827a;
        font-size: .78rem;
        font-weight: 800;
    }

    .manager-stat-icon {
        display: grid;
        width: 38px;
        height: 38px;
        flex: 0 0 38px;
        place-items: center;
        border-radius: 12px;
        background: #edf4ed;
        color: #2f6b3b;
    }

    .manager-stat-card.alert .manager-stat-icon {
        background: rgba(215, 169, 28, .13);
        color: #9a790f;
    }

    .manager-stat-value {
        margin-top: .65rem;
        color: #263029;
        font-size: 1.85rem;
        font-weight: 850;
        line-height: 1;
    }

    .manager-stat-value.money {
        font-size: 1.55rem;
    }

    .manager-stat-detail {
        margin-top: .48rem;
        color: #879087;
        font-size: .76rem;
    }

    .manager-tools-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: .8rem;
    }

    .manager-tool-card {
        display: flex;
        min-height: 92px;
        align-items: center;
        gap: .85rem;
        border: 1px solid #e4e8df;
        border-radius: 16px;
        background: #fffef9;
        box-shadow: 0 8px 22px rgba(58, 76, 61, .06);
        color: #29322b;
        padding: .9rem;
        text-decoration: none;
        transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease;
    }

    .manager-tool-card:hover {
        transform: translateY(-3px);
        border-color: rgba(47, 107, 59, .28);
        box-shadow: 0 14px 28px rgba(58, 76, 61, .11);
        color: #29322b;
    }

    .manager-tool-icon {
        display: grid;
        width: 48px;
        height: 48px;
        flex: 0 0 48px;
        place-items: center;
        border-radius: 14px;
        background: #edf4ed;
        color: #2f6b3b;
        font-size: 1.1rem;
    }

    .manager-tool-card.red .manager-tool-icon {
        background: #fdebe8;
        color: #bd3124;
    }

    .manager-tool-card.blue .manager-tool-icon {
        background: #edf3fb;
        color: #4470a1;
    }

    .manager-tool-card.yellow .manager-tool-icon {
        background: #fff4ce;
        color: #9a790f;
    }

    .manager-tool-copy {
        display: grid;
        min-width: 0;
    }

    .manager-tool-copy strong {
        font-size: .92rem;
    }

    .manager-tool-copy small {
        margin-top: .18rem;
        color: #879087;
    }

    .manager-tool-arrow {
        margin-left: auto;
        color: #adb5ae;
    }

    @@media (max-width: 991.98px) {
        .manager-stat-card,
        .manager-stat-card.wide {
            grid-column: span 6;
        }

        .manager-tools-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 575.98px) {
        .manager-dashboard-page {
            padding: 1.25rem .75rem 2rem;
        }

        .manager-dashboard-hero {
            align-items: flex-start;
            flex-direction: column;
            min-height: 0;
        }

        .manager-user-chip {
            width: 100%;
        }

        .manager-stat-card,
        .manager-stat-card.wide {
            grid-column: span 12;
        }

        .manager-tools-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="manager-dashboard-page">
    @if (TempData["AdminMessage"] != null)
    {
        <div class="alert alert-success rounded-3">@TempData["AdminMessage"]</div>
    }
    @if (TempData["AdminError"] != null)
    {
        <div class="alert alert-danger rounded-3">@TempData["AdminError"]</div>
    }

    <header class="manager-dashboard-hero">
        <div class="manager-hero-copy">
            <span class="manager-eyebrow">
                <i class="bi bi-speedometer2" aria-hidden="true"></i> Manager console
            </span>
            <h1>แดชบอร์ดผู้จัดการ</h1>
            <p>จัดการเมนู พนักงาน ออเดอร์ โปรโมชั่น และยอดขายประจำวัน</p>
        </div>
        <div class="manager-user-chip">
            <span class="manager-user-icon"><i class="bi bi-person-fill" aria-hidden="true"></i></span>
            <span class="manager-user-copy">
                <strong>@User.Identity?.Name</strong>
                <span>ผู้จัดการร้าน</span>
            </span>
        </div>
    </header>

    <section class="manager-dashboard-section">
        <div class="manager-section-heading">
            <h2>ภาพรวมวันนี้</h2>
            <span>งานร้านและยอดรับชำระที่อัปเดตแล้ว</span>
        </div>
        <div class="manager-stat-grid">
            <article class="manager-stat-card wide">
                <div class="manager-stat-top">
                    <span class="manager-stat-label">ยอดรับชำระวันนี้</span>
                    <span class="manager-stat-icon"><i class="bi bi-cash-stack" aria-hidden="true"></i></span>
                </div>
                <div class="manager-stat-value money">฿@Model.TodayPaidTotal.ToString("N2")</div>
                <div class="manager-stat-detail">ออเดอร์วันนี้ @Model.TodayOrderCount รายการ · ยอดรวม ฿@Model.TodayOrderTotal.ToString("N2")</div>
            </article>

            <article class="manager-stat-card alert">
                <div class="manager-stat-top">
                    <span class="manager-stat-label">สลิปรอตรวจ</span>
                    <span class="manager-stat-icon"><i class="bi bi-wallet2" aria-hidden="true"></i></span>
                </div>
                <div class="manager-stat-value">@Model.PendingPaymentCount</div>
                <div class="manager-stat-detail">รายการรอตรวจหรือส่งใหม่</div>
            </article>

            <article class="manager-stat-card">
                <div class="manager-stat-top">
                    <span class="manager-stat-label">เมนูทั้งหมด</span>
                    <span class="manager-stat-icon"><i class="bi bi-journal-richtext" aria-hidden="true"></i></span>
                </div>
                <div class="manager-stat-value">@Model.MenuCount</div>
                <div class="manager-stat-detail">พร้อมขายและปิดขาย</div>
            </article>

            <article class="manager-stat-card">
                <div class="manager-stat-top">
                    <span class="manager-stat-label">พนักงานในระบบ</span>
                    <span class="manager-stat-icon"><i class="bi bi-person-badge" aria-hidden="true"></i></span>
                </div>
                <div class="manager-stat-value">@Model.UserCount</div>
                <div class="manager-stat-detail">ดูรายชื่อและติดต่อพนักงาน</div>
            </article>

            <article class="manager-stat-card alert">
                <div class="manager-stat-top">
                    <span class="manager-stat-label">ออเดอร์รอร้าน</span>
                    <span class="manager-stat-icon"><i class="bi bi-receipt" aria-hidden="true"></i></span>
                </div>
                <div class="manager-stat-value">@Model.PendingOrderCount</div>
                <div class="manager-stat-detail">รายการรอดำเนินการ</div>
            </article>

            <article class="manager-stat-card alert">
                <div class="manager-stat-top">
                    <span class="manager-stat-label">การจองรอยืนยัน</span>
                    <span class="manager-stat-icon"><i class="bi bi-calendar2-check" aria-hidden="true"></i></span>
                </div>
                <div class="manager-stat-value">@Model.PendingReservationCount</div>
                <div class="manager-stat-detail">เปิดหน้าจัดการการจอง</div>
            </article>
        </div>
    </section>

    <section class="manager-dashboard-section">
        <div class="manager-section-heading">
            <h2>เครื่องมือผู้จัดการ</h2>
            <span>งานที่ใช้บ่อยประจำร้าน</span>
        </div>
        <div class="manager-tools-grid">
            <a asp-action="Menus" class="manager-tool-card red">
                <span class="manager-tool-icon"><i class="bi bi-journal-richtext" aria-hidden="true"></i></span>
                <span class="manager-tool-copy">
                    <strong>จัดการเมนู</strong>
                    <small>เพิ่ม แก้ไข และปิดขายเมนู</small>
                </span>
                <i class="bi bi-chevron-right manager-tool-arrow" aria-hidden="true"></i>
            </a>

            <a asp-action="Promotions" asp-fragment="promotion-create" class="manager-tool-card blue">
                <span class="manager-tool-icon"><i class="bi bi-megaphone" aria-hidden="true"></i></span>
                <span class="manager-tool-copy">
                    <strong>จัดการโปรโมชั่น</strong>
                    <small>เพิ่ม แก้ไข และลบโปรโมชัน</small>
                </span>
                <i class="bi bi-chevron-right manager-tool-arrow" aria-hidden="true"></i>
            </a>

            <a asp-action="Orders" class="manager-tool-card yellow">
                <span class="manager-tool-icon"><i class="bi bi-receipt" aria-hidden="true"></i></span>
                <span class="manager-tool-copy">
                    <strong>ตรวจสอบออเดอร์</strong>
                    <small>สถานะงานและการชำระเงิน</small>
                </span>
                <i class="bi bi-chevron-right manager-tool-arrow" aria-hidden="true"></i>
            </a>

            <a asp-action="Reservations" class="manager-tool-card">
                <span class="manager-tool-icon"><i class="bi bi-calendar2-check" aria-hidden="true"></i></span>
                <span class="manager-tool-copy">
                    <strong>จัดการการจอง</strong>
                    <small>ยืนยัน ยกเลิก และดูโต๊ะลูกค้า</small>
                </span>
                <i class="bi bi-chevron-right manager-tool-arrow" aria-hidden="true"></i>
            </a>

            <a asp-action="Users" class="manager-tool-card blue">
                <span class="manager-tool-icon"><i class="bi bi-people" aria-hidden="true"></i></span>
                <span class="manager-tool-copy">
                    <strong>ดูแลพนักงาน</strong>
                    <small>ดูรายชื่อและข้อมูลติดต่อ</small>
                </span>
                <i class="bi bi-chevron-right manager-tool-arrow" aria-hidden="true"></i>
            </a>

            <a asp-action="Reports" class="manager-tool-card yellow">
                <span class="manager-tool-icon"><i class="bi bi-graph-up-arrow" aria-hidden="true"></i></span>
                <span class="manager-tool-copy">
                    <strong>รายงานยอดขาย</strong>
                    <small>ดูยอดขายและออเดอร์ที่เสร็จ</small>
                </span>
                <i class="bi bi-chevron-right manager-tool-arrow" aria-hidden="true"></i>
            </a>
        </div>
    </section>
</div>
