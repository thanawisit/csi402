@model AdminDashboardViewModel
@{
    var normalizedRole = AppRoles.NormalizeRole(
        User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value);
    var roleLabel = normalizedRole != null && AppRoles.Labels.TryGetValue(normalizedRole, out var label)
        ? label
        : "พนักงาน";
    ViewData["Title"] = "แดชบอร์ดพนักงาน";
}

<style>
    .staff-dashboard {
        --staff-green: #2f6b3b;
        --staff-green-dark: #24532e;
        --staff-red: #bd3124;
        max-width: 1180px;
        margin: 0 auto;
        padding: 2rem 1.25rem 3rem;
    }

    .staff-dashboard-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .staff-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        color: var(--staff-green);
        font-size: .78rem;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
    }

    .staff-eyebrow::before {
        content: "";
        width: 28px;
        height: 3px;
        border-radius: 99px;
        background: var(--staff-red);
    }

    .staff-date {
        color: #7b817d;
        font-size: .88rem;
        white-space: nowrap;
    }

    .staff-summary-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1rem;
        margin-bottom: 1.25rem;
    }

    .staff-summary-card {
        position: relative;
        min-height: 148px;
        overflow: hidden;
        border: 1px solid #e8ece8;
        border-radius: 18px;
        background: #fff;
        box-shadow: 0 10px 28px rgba(31, 55, 39, .07);
        padding: 1.25rem;
    }

    .staff-summary-card::after {
        content: "";
        position: absolute;
        right: -24px;
        bottom: -44px;
        width: 108px;
        height: 108px;
        border-radius: 50%;
        background: rgba(47, 107, 59, .055);
    }

    .staff-summary-card.reservation {
        color: #fff;
        border: 0;
        background: linear-gradient(135deg, var(--staff-red), #8f241a);
        box-shadow: 0 14px 30px rgba(189, 49, 36, .16);
    }

    .staff-summary-card.reservation::after {
        background: rgba(255, 255, 255, .08);
    }

    .staff-summary-label {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .75rem;
        color: #737a75;
        font-size: .84rem;
        font-weight: 700;
    }

    .staff-summary-card.reservation .staff-summary-label,
    .staff-summary-card.reservation .staff-summary-detail {
        color: rgba(255, 255, 255, .78);
    }

    .staff-summary-icon {
        display: grid;
        width: 38px;
        height: 38px;
        place-items: center;
        border-radius: 12px;
        background: #edf5ef;
        color: var(--staff-green);
        font-size: 1.05rem;
    }

    .staff-summary-card.reservation .staff-summary-icon {
        background: rgba(255, 255, 255, .14);
        color: #fff;
    }

    .staff-summary-value {
        margin-top: .8rem;
        color: #202722;
        font-size: 2.15rem;
        font-weight: 850;
        line-height: 1;
    }

    .staff-summary-card.reservation .staff-summary-value {
        color: #fff;
    }

    .staff-summary-detail {
        margin-top: .55rem;
        color: #868d88;
        font-size: .78rem;
    }

    .staff-quick-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
        margin-bottom: 1.25rem;
    }

    .staff-action-card {
        display: flex;
        min-height: 92px;
        align-items: center;
        gap: .9rem;
        border: 1px solid #e6ebe7;
        border-radius: 16px;
        background: #fff;
        color: #263029;
        padding: 1rem;
        text-decoration: none;
        transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease;
    }

    .staff-action-card:hover {
        transform: translateY(-2px);
        border-color: rgba(47, 107, 59, .28);
        box-shadow: 0 12px 24px rgba(31, 55, 39, .08);
        color: #263029;
    }

    .staff-action-icon {
        display: grid;
        width: 48px;
        height: 48px;
        flex: 0 0 48px;
        place-items: center;
        border-radius: 14px;
        background: #eff6f0;
        color: var(--staff-green);
        font-size: 1.25rem;
    }

    .staff-action-copy {
        display: grid;
        min-width: 0;
    }

    .staff-action-copy strong {
        font-size: .95rem;
    }

    .staff-action-copy small {
        margin-top: .18rem;
        color: #858c87;
    }

    .staff-action-arrow {
        margin-left: auto;
        color: #a0a7a2;
    }

    .staff-orders-card {
        overflow: hidden;
        border: 1px solid #e8ece8;
        border-radius: 18px;
        background: #fff;
        box-shadow: 0 10px 28px rgba(31, 55, 39, .06);
    }

    .staff-orders-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        border-bottom: 1px solid #edf0ed;
        padding: 1.15rem 1.25rem;
    }

    .staff-orders-header h2 {
        margin: 0;
        font-size: 1.05rem;
        font-weight: 800;
    }

    .staff-status {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        background: #f2f4f2;
        color: #657067;
        padding: .35rem .65rem;
        font-size: .75rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .staff-status.pending {
        background: #fff1cc;
        color: #956800;
    }

    .staff-status.confirmed {
        background: #e8f3eb;
        color: #356d43;
    }

    .staff-status.warning {
        background: #ffe9e6;
        color: #a3392f;
    }

    @@media (max-width: 991.98px) {
        .staff-summary-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 575.98px) {
        .staff-dashboard {
            padding: 1.25rem .75rem 2rem;
        }

        .staff-dashboard-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .staff-summary-grid,
        .staff-quick-grid {
            grid-template-columns: 1fr;
        }

        .staff-summary-card {
            min-height: 132px;
        }
    }
</style>

<div class="staff-dashboard">
    @if (TempData["AdminMessage"] != null)
    {
        <div class="alert alert-success rounded-3">@TempData["AdminMessage"]</div>
    }
    @if (TempData["AdminError"] != null)
    {
        <div class="alert alert-danger rounded-3">@TempData["AdminError"]</div>
    }

    <header class="staff-dashboard-header">
        <div>
            <span class="staff-eyebrow">ระบบพนักงาน</span>
            <h1 class="h2 fw-bold mt-2 mb-1">สวัสดี, @User.Identity?.Name</h1>
            <p class="text-muted mb-0">ภาพรวมงานร้านสำหรับ @roleLabel วันนี้</p>
        </div>
        <div class="staff-date">
            <i class="bi bi-calendar3 me-1" aria-hidden="true"></i>
            @DateTime.Now.ToString("dd MMMM yyyy")
        </div>
    </header>

    <section class="staff-summary-grid" aria-label="ภาพรวมงานร้าน">
        <article class="staff-summary-card reservation">
            <div class="staff-summary-label">
                <span>รอยืนยันการจอง</span>
                <span class="staff-summary-icon"><i class="bi bi-calendar2-check" aria-hidden="true"></i></span>
            </div>
            <div class="staff-summary-value">@Model.PendingReservationCount</div>
            <div class="staff-summary-detail">รายการรอ Staff จัดการ</div>
        </article>

        <article class="staff-summary-card">
            <div class="staff-summary-label">
                <span>ออเดอร์รอรับบริการ</span>
                <span class="staff-summary-icon"><i class="bi bi-receipt" aria-hidden="true"></i></span>
            </div>
            <div class="staff-summary-value">@Model.PendingOrderCount</div>
            <div class="staff-summary-detail">รายการที่ต้องเริ่มดำเนินการ</div>
        </article>

        <article class="staff-summary-card">
            <div class="staff-summary-label">
                <span>ออเดอร์วันนี้</span>
                <span class="staff-summary-icon"><i class="bi bi-basket3" aria-hidden="true"></i></span>
            </div>
            <div class="staff-summary-value">@Model.TodayOrderCount</div>
            <div class="staff-summary-detail">ยอดรวม ฿@Model.TodayOrderTotal.ToString("N0")</div>
        </article>

        <article class="staff-summary-card">
            <div class="staff-summary-label">
                <span>สลิปรอตรวจ</span>
                <span class="staff-summary-icon"><i class="bi bi-wallet2" aria-hidden="true"></i></span>
            </div>
            <div class="staff-summary-value">@Model.PendingPaymentCount</div>
            <div class="staff-summary-detail">รับชำระแล้ว ฿@Model.TodayPaidTotal.ToString("N0") วันนี้</div>
        </article>
    </section>

    <nav class="staff-quick-grid" aria-label="เมนูปฏิบัติงาน">
        <a asp-action="Reservations" class="staff-action-card">
            <span class="staff-action-icon"><i class="bi bi-calendar-check" aria-hidden="true"></i></span>
            <span class="staff-action-copy">
                <strong>จัดการการจอง</strong>
                <small>ยืนยันโต๊ะและอัปเดตสถานะ</small>
            </span>
            <i class="bi bi-chevron-right staff-action-arrow" aria-hidden="true"></i>
        </a>
        <a asp-action="Orders" class="staff-action-card">
            <span class="staff-action-icon"><i class="bi bi-clipboard2-check" aria-hidden="true"></i></span>
            <span class="staff-action-copy">
                <strong>จัดการออเดอร์</strong>
                <small>ตรวจรายการและการชำระเงิน</small>
            </span>
            <i class="bi bi-chevron-right staff-action-arrow" aria-hidden="true"></i>
        </a>
        <a asp-action="Stock" class="staff-action-card">
            <span class="staff-action-icon"><i class="bi bi-box-seam" aria-hidden="true"></i></span>
            <span class="staff-action-copy">
                <strong>จัดการสต็อก</strong>
                <small>อัปเดตจำนวนและสถานะขาย</small>
            </span>
            <i class="bi bi-chevron-right staff-action-arrow" aria-hidden="true"></i>
        </a>
    </nav>

    <section class="staff-orders-card">
        <div class="staff-orders-header">
            <h2>ออเดอร์ล่าสุด</h2>
            <a asp-action="Orders" class="btn btn-sm btn-outline-success rounded-3">ดูทั้งหมด</a>
        </div>

        @if (Model.RecentOrders.Count == 0)
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-inbox fs-2 d-block mb-2" aria-hidden="true"></i>
                ยังไม่มีออเดอร์ในระบบ
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">เลขออเดอร์</th>
                            <th>ลูกค้า</th>
                            <th>รูปแบบ</th>
                            <th>เวลา</th>
                            <th>ยอดรวม</th>
                            <th class="pe-4">สถานะ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.RecentOrders)
                        {
                            var statusClass = order.OrderStatus == "รอดำเนินการ"
                                ? "pending"
                                : order.OrderStatus == "ยกเลิก"
                                    ? "warning"
                                    : "confirmed";
                            <tr>
                                <td class="ps-4 fw-bold">เลขที่คำสั่งซื้อ @order.DisplayNumber</td>
                                <td>@order.User?.Username</td>
                                <td>
                                    <span class="fw-semibold">@order.OrderType</span>
                                    @if (order.DiningTable != null)
                                    {
                                        <span class="text-muted small d-block">โต๊ะ @order.DiningTable.TableNumber</span>
                                    }
                                    else if (order.ArriveTime != "-")
                                    {
                                        <span class="text-muted small d-block">รับ @order.ArriveTime น.</span>
                                    }
                                </td>
                                <td class="text-nowrap">@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="fw-bold">฿@order.TotalAmount.ToString("N2")</td>
                                <td class="pe-4">
                                    <span class="staff-status @statusClass">@OrderStatusLabels.Display(order.OrderStatus)</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
