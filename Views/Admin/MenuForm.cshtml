@model MenuInputViewModel
@{
    var isEdit = Model.MenuId.HasValue;
    ViewData["Title"] = isEdit ? "แก้ไขเมนู" : "เพิ่มเมนู";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">
                    <h1 class="h3 fw-bold mb-4">@ViewData["Title"]</h1>
                    <form asp-action="@(isEdit ? "MenuEdit" : "MenuCreate")" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        <input asp-for="MenuId" type="hidden" />
                        <div class="mb-3">
                            <label asp-for="MenuName" class="form-label"></label>
                            <input asp-for="MenuName" class="form-control" />
                            <span asp-validation-for="MenuName" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Price" class="form-label"></label>
                            <input asp-for="Price" class="form-control" type="number" step="0.01" min="0.01" />
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="Status" class="form-label"></label>
                            <select asp-for="Status" class="form-select">
                                @foreach (var status in (string[])ViewBag.MenuStatuses)
                                {
                                    <option value="@status">@(status == "Available" ? "พร้อมขาย" : "ปิดขาย")</option>
                                }
                            </select>
                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Model.CurrentImagePath))
                        {
                            <div class="mb-3">
                                <label class="form-label">รูปปัจจุบัน</label>
                                <div>
                                    <img src="@Model.CurrentImagePath" alt="รูปเมนู @Model.MenuName"
                                         class="img-thumbnail" style="max-width: 240px; max-height: 180px; object-fit: cover;" />
                                </div>
                            </div>
                        }
                        <div class="mb-4">
                            <label asp-for="ImageFile" class="form-label"></label>
                            <input asp-for="ImageFile" type="file" accept=".jpg,.jpeg,.png,image/jpeg,image/png" class="form-control" />
                            <span asp-validation-for="ImageFile" class="text-danger"></span>
                            <div class="form-text">รองรับ JPG หรือ PNG ขนาดไม่เกิน 5 MB@(isEdit ? " หากไม่เลือกรูปใหม่จะใช้รูปเดิม" : "")</div>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger">บันทึก</button>
                            <a asp-action="Menus" class="btn btn-outline-secondary">ยกเลิก</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
