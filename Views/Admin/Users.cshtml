@model IEnumerable<AdminUserListItemViewModel>
@{
    ViewData["Title"] = "ดูแลพนักงาน";
}

<div class="container py-4">
    <h1 class="fw-bold mb-1">@ViewData["Title"]</h1>
    <p class="text-muted mb-4">แสดงรายชื่อและข้อมูลติดต่อของพนักงาน บทบาทบัญชีจัดการได้จากหน้าแยกสำหรับแอดมิน</p>

    @if (TempData["AdminMessage"] != null)
    {
        <div class="alert alert-success">@TempData["AdminMessage"]</div>
    }
    @if (TempData["AdminError"] != null)
    {
        <div class="alert alert-danger">@TempData["AdminError"]</div>
    }

    <div class="card border-0 shadow-sm rounded-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">ชื่อพนักงาน</th>
                        <th>อีเมล</th>
                        <th>โทรศัพท์</th>
                        <th>บทบาท</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var account in Model)
                    {
                        <tr>
                            <td class="ps-4">@account.Username</td>
                            <td>@account.Email</td>
                            <td>@(account.PhoneNumber ?? "-")</td>
                            <td>@(AppRoles.Labels.TryGetValue(account.Role, out var label) ? label : account.Role)</td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-5">ยังไม่มีข้อมูลพนักงาน</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
