@model SalesReportViewModel
@{
    ViewData["Title"] = "รายงานยอดขาย";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="fw-bold mb-1">รายงานยอดขาย</h1>
            <p class="text-muted mb-0">คำนวณจากออเดอร์ที่เสร็จแล้วและยืนยันการชำระเงินแล้ว</p>
        </div>
        <a asp-action="Menus" class="btn btn-outline-danger">
            <i class="bi bi-journal-text me-1"></i>จัดการเมนู
        </a>
    </div>

    <form asp-action="Reports" method="get" class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <div class="row g-3 align-items-end">
                <div class="col-sm-5 col-lg-4">
                    <label for="fromDate" class="form-label">ตั้งแต่วันที่</label>
                    <input id="fromDate" name="fromDate" type="date" class="form-control"
                           value="@Model.StartDate.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)" />
                </div>
                <div class="col-sm-5 col-lg-4">
                    <label for="toDate" class="form-label">ถึงวันที่</label>
                    <input id="toDate" name="toDate" type="date" class="form-control"
                           value="@Model.EndDate.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)" />
                </div>
                <div class="col-sm-2 col-lg-4">
                    <button type="submit" class="btn btn-success w-100">
                        <i class="bi bi-search me-1"></i>ดูรายงาน
                    </button>
                </div>
            </div>
        </div>
    </form>

    @if (Model.ErrorMessage != null)
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }
    else
    {
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-4">
                        <div class="text-muted">ยอดขายรวม</div>
                        <div class="display-6 fw-bold text-success">฿@Model.TotalSales.ToString("N2")</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-4">
                        <div class="text-muted">ออเดอร์ที่เสร็จแล้ว</div>
                        <div class="display-6 fw-bold">@Model.CompletedOrderCount</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-4">
                        <div class="text-muted">ยอดเฉลี่ยต่อออเดอร์</div>
                        <div class="display-6 fw-bold text-primary">฿@Model.AverageOrderAmount.ToString("N2")</div>
                    </div>
                </div>
            </div>
        </div>

        <section class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                    <h2 class="h5 fw-bold mb-0">รายการขายที่เสร็จแล้ว</h2>
                    @if (Model.CompletedOrderCount > Model.CompletedOrders.Count)
                    {
                        <span class="small text-muted">แสดง 50 รายการล่าสุด จาก @Model.CompletedOrderCount รายการ</span>
                    }
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>เลขออเดอร์</th>
                                <th>วันที่</th>
                                <th>ลูกค้า</th>
                                <th>รูปแบบ</th>
                                <th>การชำระเงิน</th>
                                <th class="text-end">ยอดรวม</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.CompletedOrders)
                            {
                                <tr>
                                    <td>@("#ORD" + order.OrderID.ToString("D4"))</td>
                                    <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@order.User?.Username</td>
                                    <td>
                                        @order.OrderType
                                        @if (order.DiningTable != null)
                                        {
                                            <div class="small text-muted">โต๊ะ @order.DiningTable.TableNumber</div>
                                        }
                                        else if (order.ArriveTime != "-")
                                        {
                                            <div class="small text-muted">รับเวลา @order.ArriveTime น.</div>
                                        }
                                        @if (order.BuffetGuestCount is int guestCount)
                                        {
                                            <div class="small text-muted">บุฟเฟต์ @guestCount คน</div>
                                        }
                                    </td>
                                    <td>@order.PaymentMethod</td>
                                    <td class="text-end">฿@order.TotalAmount.ToString("N2")</td>
                                </tr>
                            }
                            @if (Model.CompletedOrders.Count == 0)
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-5">
                                        ไม่พบออเดอร์ที่เสร็จแล้วในช่วงวันที่เลือก
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    }
</div>
