@model IsanDer.Models.User

@{
    ViewData["Title"] = "โปรไฟล์ของฉัน";
        var initial = string.IsNullOrWhiteSpace(Model.Username)
            ? "?"
            : Model.Username.Substring(0, 1).ToUpperInvariant();
}

    <style>
        .profile-page { max-width: 900px; }
        .profile-header {
            background: linear-gradient(120deg, #bd3124, #8f251c);
            color: white;
            padding: 36px;
        }
        .profile-avatar {
            width: 88px;
            height: 88px;
            border-radius: 50%;
            background: rgba(255,255,255,.18);
            border: 2px solid rgba(255,255,255,.55);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            font-weight: 700;
        }
        .profile-info-row { padding: 16px 0; border-bottom: 1px solid #eee; }
        .profile-info-row:last-child { border-bottom: 0; }
        .text-brand { color: #bd3124; }
    </style>

    <div class="container profile-page mt-5 pb-5">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="profile-header d-flex flex-column flex-sm-row align-items-center gap-4">
                <div class="profile-avatar" aria-hidden="true">@initial</div>
                <div class="text-center text-sm-start">
                    <h2 class="fw-bold mb-1">@Model.Username</h2>
                    <p class="mb-0 opacity-75">@Model.Email</p>
                </div>
            </div>

            <div class="card-body p-4 p-md-5">
                <h4 class="fw-bold mb-3">ข้อมูลบัญชี</h4>
                <div class="profile-info-row row">
                    <div class="col-sm-4 text-muted">ชื่อผู้ใช้</div>
                    <div class="col-sm-8 fw-semibold">@Model.Username</div>
                </div>
                <div class="profile-info-row row">
                    <div class="col-sm-4 text-muted">อีเมล</div>
                    <div class="col-sm-8 fw-semibold">@Model.Email</div>
                </div>
                <div class="profile-info-row row">
                    <div class="col-sm-4 text-muted">เบอร์โทรศัพท์</div>
                    <div class="col-sm-8 fw-semibold">@(Model.PhoneNumber ?? "ยังไม่ได้ระบุ")</div>
                </div>
                <div class="profile-info-row row">
                    <div class="col-sm-4 text-muted">วันเกิด</div>
                    <div class="col-sm-8 fw-semibold">@(Model.DateOfBirth?.ToString("dd/MM/yyyy") ?? "ยังไม่ได้ระบุ")</div>
                </div>
                <div class="d-flex flex-column flex-sm-row gap-2 mt-4">
                    <a asp-controller="Home" asp-action="OrderHistory" class="btn btn-danger fw-bold">ประวัติการสั่งซื้อ</a>
                    <a asp-controller="Home" asp-action="Menu" class="btn btn-outline-danger fw-bold">เลือกอาหาร</a>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="ms-sm-auto">
                        <button type="submit" class="btn btn-outline-secondary fw-bold w-100">ออกจากระบบ</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>