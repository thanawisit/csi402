@{
    ViewData["Title"] = "หน้าแรก";
}

<style>
    /* กำหนดสีพื้นหลังและสีหลักของเว็บให้เหมือนในรูป */
    body {
        background-color: #fffaf4; /* สีพื้นหลังครีมอ่อน */
    }
    .text-brand {
        color: #bd3124; /* สีแดงของแบรนด์ */
    }
    .bg-brand {
        background-color: #bd3124;
        color: white;
    }
    .btn-brand {
        background-color: #bd3124;
        color: white;
        border: none;
        transition: 0.3s;
    }
    .btn-brand:hover {
        background-color: #9c271c;
        color: white;
    }
    
    /* สไตล์กล่องโปรโมชั่น */
    .promo-card {
        border-radius: 12px;
        padding: 50px 20px;
        font-size: 1.5rem;
        font-weight: bold;
        text-align: center;
    }
    .promo-green {
        background-color: #377d33;
        color: white;
    }

    /* สไตล์การ์ดเมนูอาหาร */
    .menu-card {
        background-color: white;
        border: 1px solid #f2e6d9;
        border-radius: 16px;
    }
    .img-placeholder {
        background-color: #f4e8d8;
        height: 180px;
        border-radius: 12px;
        margin: 12px 12px 0 12px;
    }
    .search-box {
        background-color: #fdf4e6;
        border: 1px solid #f2e6d9;
    }
</style>

<div class="container mt-5 pb-5">
    
    <!-- 1. ส่วนต้อนรับ (Hero Section) -->
    <div class="mb-5">
        <h1 class="fw-bold">ยินดีต้อนรับสู่ อีสาน เด้อ</h1>
        <p class="text-muted fs-5 mb-4">อาหารอีสานรสแซ่บ สดใหม่ทุกวัน</p>
        
        <div class="d-flex gap-3 align-items-center" style="max-width: 850px;">
            <button class="btn btn-brand px-5 py-3 rounded-3 fs-5 fw-bold shadow-sm">สั่งอาหาร</button>
            <div class="flex-grow-1">
                <input type="text" class="form-control form-control-lg search-box py-3 rounded-3" placeholder="ค้นหาเมนูอาหาร เช่น ส้มตำ ลาบ คอหมูย่าง">
            </div>
        </div>
    </div>

    <!-- 2. ส่วนโปรโมชั่น -->
    <div class="mb-5">
        <h3 class="fw-bold mb-4">โปรโมชั่น</h3>
        <div class="row g-4">
            <div class="col-md-6">
                <div class="promo-card bg-brand shadow-sm">
                    ถ้าสมัครสมาชิกจะได้รับชามะลิฟรี
                </div>
            </div>
            <div class="col-md-6">
                <div class="promo-card promo-green shadow-sm">
                    เด็กที่สูงน้อยกว่า 120 ซม. กินฟรี
                </div>
            </div>
        </div>
    </div>

    <!-- 3. ส่วนเมนูแนะนำ -->
    <div class="mb-4">
        <h3 class="fw-bold mb-4">เมนูแนะนำ</h3>
        <div class="row g-4">
            
            <!-- เมนูที่ 1 -->
            <div class="col-md-4">
                <div class="menu-card shadow-sm h-100 pb-2">
                    <div class="img-placeholder"></div>
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-1">ส้มตำไทย</h5>
                        <p class="text-muted small mb-3">⭐ 4.8 · อาหารอีสาน</p>
                        <div class="d-flex justify-content-between align-items-center mt-4">
                            <span class="text-brand fs-4 fw-bold">฿60</span>
                            <button class="btn btn-brand px-4 py-2 rounded-pill fw-bold">+ เพิ่ม</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- เมนูที่ 2 -->
            <div class="col-md-4">
                <div class="menu-card shadow-sm h-100 pb-2">
                    <div class="img-placeholder"></div>
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-1">ลาบหมู</h5>
                        <p class="text-muted small mb-3">⭐ 4.8 · อาหารอีสาน</p>
                        <div class="d-flex justify-content-between align-items-center mt-4">
                            <span class="text-brand fs-4 fw-bold">฿90</span>
                            <button class="btn btn-brand px-4 py-2 rounded-pill fw-bold">+ เพิ่ม</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- เมนูที่ 3 -->
            <div class="col-md-4">
                <div class="menu-card shadow-sm h-100 pb-2">
                    <div class="img-placeholder"></div>
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-1">คอหมูย่าง</h5>
                        <p class="text-bold mb-3 text-muted small">⭐ 4.8 · อาหารอีสาน</p>
                        <div class="d-flex justify-content-between align-items-center mt-4">
                            <span class="text-brand fs-4 fw-bold">฿120</span>
                            <button class="btn btn-brand px-4 py-2 rounded-pill fw-bold">+ เพิ่ม</button>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

</div>