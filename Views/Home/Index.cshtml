@model HomePageViewModel
@{
    ViewData["Title"] = "หน้าแรก";
}

<style>
    .text-brand {
        color: var(--brand-red);
    }
    .bg-brand {
        background-color: var(--brand-red);
        color: white;
    }
    .btn-brand {
        background-color: var(--brand-red);
        color: white;
        border: none;
        transition: 0.3s;
    }
    .btn-brand:hover {
        background-color: var(--brand-red-dark);
        color: white;
    }
    
    .menu-card {
        background-color: white;
        border: 1px solid var(--border);
        border-radius: 16px;
    }
    .search-box {
        background-color: var(--brand-green-soft);
        border: 1px solid var(--border);
    }
</style>

<div class="container mt-5 pb-5">
    <section class="mb-5 hero-panel p-4 p-md-5">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <span class="hero-kicker"><i class="bi bi-fire"></i> รสอีสานแท้ ทำสดใหม่ทุกวัน</span>
                <h1 class="hero-title fw-bold">แซ่บนัว<br><span>ถึงใจทุกคำ</span></h1>
                <p class="text-muted fs-5 mb-4">มื้ออร่อยแบบอีสานแท้ เลือกเมนูโปรดแล้วให้เราจัดความแซ่บถึงโต๊ะ</p>

                <div class="d-flex flex-column flex-md-row gap-3 align-items-stretch align-items-md-center">
                    <a asp-controller="Home" asp-action="Menu" class="btn btn-brand px-4 py-3 rounded-3 fw-bold text-decoration-none">
                        เลือกเมนู <i class="bi bi-arrow-right ms-2"></i>
                    </a>
                    <form asp-controller="Home" asp-action="Menu" method="get" class="flex-grow-1">
                        <div class="input-group">
                            <input type="search" name="q" class="form-control form-control-lg search-box py-3 rounded-start-3" placeholder="ค้นหาเมนู เช่น ส้มตำ ลาบ คอหมูย่าง" aria-label="ค้นหาเมนูอาหาร">
                            <button type="submit" class="btn btn-success px-3" aria-label="ค้นหา">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </form>
                </div>

                <div class="hero-highlights">
                    <span><i class="bi bi-check-circle-fill"></i> วัตถุดิบสดใหม่</span>
                    <span><i class="bi bi-check-circle-fill"></i> รสชาติจัดจ้าน</span>
                    <span><i class="bi bi-check-circle-fill"></i> อิ่มอร่อยทุกมื้อ</span>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="hero-art" aria-hidden="true">
                    <div class="hero-orbit">
                        <div class="hero-dish"><i class="bi bi-egg-fried"></i></div>
                    </div>
                    <span class="hero-float hero-float-top"><i class="bi bi-stars"></i> แซ่บสะใจ</span>
                    <span class="hero-float hero-float-bottom"><i class="bi bi-leaf-fill"></i> สดใหม่ทุกวัน</span>
                </div>
            </div>
        </div>
    </section>

    <section class="mb-5">
        @if (Model.Promotions.Count > 0)
        {
            <div class="section-heading">
                <div>
                    <span class="section-kicker">สิทธิพิเศษ</span>
                    <h3 class="fw-bold mb-0">โปรโมชั่น</h3>
                </div>
            </div>
            <div class="row g-4">
                @foreach (var promotion in Model.Promotions)
                {
                    var isMembership = promotion.SlotKey == "membership";
                    <div class="col-md-6">
                        <div class="promo-card @(isMembership ? "promo-red" : "promo-green")">
                            <span class="promo-icon">
                                <i class="bi @(isMembership ? "bi-cup-hot" : "bi-emoji-smile")"></i>
                            </span>
                            <div class="promo-content">
                                <span class="promo-label">@promotion.Kicker</span>
                                <h4 style="white-space: pre-line">@promotion.Headline</h4>
                                <p class="promo-description">@promotion.Description</p>
                                <a asp-controller="@(isMembership ? "Account" : "Home")"
                                   asp-action="@(isMembership ? "Register" : "Buffet")"
                                   class="promo-action">
                                    @promotion.LinkText <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                            <i class="bi bi-stars promo-decoration" aria-hidden="true"></i>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    <section class="mb-4">
        <div class="section-heading">
            <div>
                <span class="section-kicker">จานเด็ดประจำร้าน</span>
                <h3 class="fw-bold mb-0">เมนูแนะนำ</h3>
            </div>
            <a asp-controller="Home" asp-action="Menu" class="text-decoration-none fw-bold">ดูเมนูทั้งหมด <i class="bi bi-arrow-right"></i></a>
        </div>
        <div class="row g-4">
            @for (var index = 0; index < Model.FeaturedMenus.Count; index++)
            {
                var menu = Model.FeaturedMenus[index];
                var fallbackArt = index % 3 == 0
                    ? "food-art-somtum"
                    : index % 3 == 1
                        ? "food-art-larb"
                        : "food-art-pork";

                <div class="col-md-4">
                    <div class="menu-card shadow-sm h-100 pb-2">
                        @if (!string.IsNullOrWhiteSpace(menu.ImagePath))
                        {
                            <img src="@menu.ImagePath" alt="รูปเมนู @menu.MenuName"
                                 class="w-100" style="height: 220px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="food-art @fallbackArt" aria-hidden="true">
                                @if (index % 3 == 0)
                                {
                                    <i class="bi bi-flower1"></i>
                                }
                                else if (index % 3 == 1)
                                {
                                    <i class="bi bi-fire"></i>
                                }
                                else
                                {
                                    <i class="bi bi-egg-fried"></i>
                                }
                            </div>
                        }
                        <div class="card-body p-4">
                            <h5 class="fw-bold mb-1">@menu.MenuName</h5>
                            <p class="text-muted small mb-3">⭐ 4.8 · อาหารอีสาน</p>
                            <div class="d-flex justify-content-between align-items-center mt-4">
                                <span class="text-brand fs-4 fw-bold">฿@menu.Price.ToString("0.##")</span>
                                @if (User.Identity != null && User.Identity.IsAuthenticated)
                                {
                                    <a asp-controller="Home" asp-action="FoodDetail" asp-route-id="@menu.MenuId"
                                       class="btn btn-brand px-4 py-2 rounded-pill fw-bold text-decoration-none">+ เพิ่ม</a>
                                }
                                else
                                {
                                    <a asp-controller="Account" asp-action="Login"
                                       class="btn btn-brand px-4 py-2 rounded-pill fw-bold text-decoration-none">+ เพิ่ม</a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
            @if (Model.FeaturedMenus.Count == 0)
            {
                <div class="col-12 text-muted">ยังไม่มีเมนูพร้อมขาย</div>
            }
        </div>
    </section>
</div>