@{
    ViewData["Title"] = "สแกน QR สั่งอาหาร";
}

<style>
    .qr-card {
        background-color: white;
        border: 1px solid #f2e6d9;
        border-radius: 16px;
        padding: 60px;
        width: 100%;
        max-width: 350px;
        margin: 0 auto;
        display: flex;
        justify-content: center;
        align-items: center;
        aspect-ratio: 1 / 1;
    }
    .qr-icon {
        font-size: 8rem;
        color: #333;
    }
    .text-brand {
        color: #bd3124;
    }
</style>

<div class="container mt-5 pb-5 text-center">
    <h3 class="fw-bold mb-5">สแกน QR Code เพื่อสั่งอาหาร</h3>

    <div class="qr-card shadow-sm mb-4">
        <!-- ไอคอนตารางสี่เหลี่ยมคล้ายรูป QR Code -->
        <i class="bi bi-grid-3x3-gap-fill qr-icon"></i>
    </div>

    <h4 class="fw-bold text-brand mb-2">โต๊ะ 01</h4>
    <p class="text-muted small">สแกนด้วยกล้องโทรศัพท์ของคุณ</p>
</div>