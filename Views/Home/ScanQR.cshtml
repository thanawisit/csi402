@{
    ViewData["Title"] = "สแกนสั่งอาหาร";
}

<style>
    .qr-card {
        background-color: white;
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: 48px;
        width: 100%;
        max-width: 360px;
        margin: 0 auto;
        display: flex;
        justify-content: center;
        align-items: center;
        aspect-ratio: 1 / 1;
    }
    .qr-icon {
        font-size: 8rem;
        color: var(--brand-green);
    }
    .text-brand {
        color: var(--brand-red);
    }
</style>

<div class="container mt-5 pb-5 text-center">
    <span class="section-kicker">สแกนจากโต๊ะของคุณ</span>
    <h3 class="fw-bold mb-4">สแกนสั่งอาหาร</h3>

    <div class="qr-card shadow-sm mb-4">
        <div>
            <i class="bi bi-grid-3x3-gap-fill qr-icon" aria-hidden="true"></i>
            <div class="small text-muted mt-3">เลือกรายการและสั่งอาหารสำหรับโต๊ะนี้</div>
        </div>
    </div>

    <h4 class="fw-bold text-brand mb-2">
        @(ViewBag.TableNumber == null ? "ยังไม่ได้เลือกโต๊ะ" : $"โต๊ะ {ViewBag.TableNumber}")
    </h4>
    <p class="text-muted">กดสแกนสั่งอาหารเพื่อเปิดเมนูอาหารสำหรับโต๊ะนี้</p>

    @if (ViewBag.TableId != null)
    {
        <form asp-controller="Home" asp-action="Menu" method="get" class="mx-auto mt-3" style="max-width: 320px;">
            <input type="hidden" name="tableId" value="@ViewBag.TableId" />
            <button type="submit" class="btn btn-success px-4 py-2 mt-3">
                สแกนสั่งอาหาร
            </button>
        </form>
    }
    else
    {
        <a asp-controller="Home" asp-action="ReserveTable" asp-route-package="buffet"
           class="btn btn-outline-success px-4 py-2 mt-2">
            กลับไปเลือกโต๊ะ
        </a>
    }
</div>
