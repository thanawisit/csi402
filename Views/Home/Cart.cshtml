@model IEnumerable<IsanDer.Controllers.CartItem>

@{
    ViewData["Title"] = "ตะกร้าอาหาร - อีสาน เด้อ";
    decimal totalAmount = 0;
    var isBuffet = ViewBag.IsBuffet == true;
    var buffetTotalAmount = ViewBag.BuffetTotalAmount as decimal? ?? 0m;
}

<style>
    .cart-item-card {
        background-color: #ffffff;
        border: 1px solid var(--border);
        border-radius: 1.25rem;
        padding: 1.25rem 1.5rem;
        margin-bottom: 1rem;
        display: grid;
        grid-template-columns: 88px minmax(0, 1fr) auto;
        gap: 1.25rem;
        align-items: center;
        box-shadow: 0 4px 16px rgba(60, 20, 20, 0.04);
        transition: all 0.2s ease;
    }

    .cart-item-card:hover {
        border-color: var(--brand-red-subtle);
        box-shadow: 0 8px 24px rgba(201, 42, 42, 0.08);
    }

    .cart-item-img {
        width: 88px;
        height: 88px;
        border-radius: 1rem;
        object-fit: cover;
    }

    .cart-item-placeholder {
        width: 88px;
        height: 88px;
        border-radius: 1rem;
        display: grid;
        place-items: center;
        background: var(--brand-red-soft);
        color: var(--brand-red);
        font-size: 2rem;
    }

    .cart-qty-btn {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        border: 1.5px solid var(--brand-red);
        background: #ffffff;
        color: var(--brand-red);
        font-weight: 800;
        font-size: 0.95rem;
        padding: 0;
        transition: all 0.2s ease;
    }

    .cart-qty-btn:hover {
        background: var(--brand-red);
        color: #ffffff;
    }

    .cart-summary-card {
        background-color: #ffffff;
        border: 1px solid var(--border);
        border-radius: 1.5rem;
        padding: 2rem;
        box-shadow: 0 8px 28px rgba(60, 20, 20, 0.06);
        position: sticky;
        top: 90px;
    }

    .cart-total-price {
        font-family: 'Kanit', sans-serif;
        font-size: 1.75rem;
        font-weight: 800;
        color: var(--brand-red);
    }

    @@media (max-width: 575.98px) {
        .cart-item-card { grid-template-columns: 70px minmax(0, 1fr); gap: 12px; padding: 1rem; }
        .cart-item-img, .cart-item-placeholder { width: 70px; height: 70px; }
        .cart-item-total { grid-column: 2; justify-self: end; }
    }
</style>

<div class="container py-4 pb-5">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
        <div>
            <span class="badge bg-danger rounded-pill px-3 py-1 mb-1 fw-bold">
                <i class="bi bi-cart3 me-1"></i> ตะกร้าของฉัน
            </span>
            <h2 class="fw-bold mb-0 text-dark">รายการสั่งอาหาร</h2>
        </div>
        @if (ViewBag.TableNumber != null)
        {
            <div class="d-inline-flex align-items-center gap-2 px-3 py-2 rounded-pill bg-white border shadow-sm">
                <i class="bi bi-geo-alt-fill text-danger fs-5"></i>
                <span>โต๊ะที่คุณเลือก: <strong class="text-danger fs-6">โต๊ะ @ViewBag.TableNumber</strong></span>
            </div>
        }
    </div>

    <div class="row g-4">
        <!-- ฝั่งซ้าย: รายการอาหารในตะกร้า -->
        <div class="col-lg-8">
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    decimal rowTotal = item.Price * item.Qty;
                    totalAmount += rowTotal;

                    <div class="cart-item-card">
                        @if (!string.IsNullOrWhiteSpace(item.ImagePath))
                        {
                            <img src="@item.ImagePath" alt="รูปเมนู @item.MenuName" class="cart-item-img" loading="lazy" />
                        }
                        else
                        {
                            <div class="cart-item-placeholder" aria-hidden="true">
                                <i class="bi bi-egg-fried"></i>
                            </div>
                        }
                        
                        <div>
                            <h5 class="fw-bold mb-1 text-dark">@item.MenuName</h5>
                            @if (!string.IsNullOrWhiteSpace(item.SpecialRequest))
                            {
                                <div class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-2 py-1 mb-2">
                                    <i class="bi bi-chat-left-dots-fill me-1"></i>@item.SpecialRequest
                                </div>
                            }
                            
                            <div class="d-flex align-items-center gap-2 mt-2">
                                <span class="text-muted small me-2">
                                    @(isBuffet ? "รวมในบุฟเฟต์" : $"฿{item.Price}")
                                </span>
                                
                                <form asp-controller="Home" asp-action="DecreaseQty" method="post" class="m-0 p-0">
                                    <input type="hidden" name="menuId" value="@item.MenuId" />
                                    <input type="hidden" name="tableId" value="@ViewBag.TableId" />
                                    <button type="submit" class="cart-qty-btn" aria-label="ลดจำนวน">-</button>
                                </form>
                                
                                <span class="fw-bold px-2 fs-6">@item.Qty</span>
                                
                                <form asp-controller="Home" asp-action="IncreaseQty" method="post" class="m-0 p-0">
                                    <input type="hidden" name="menuId" value="@item.MenuId" />
                                    <input type="hidden" name="tableId" value="@ViewBag.TableId" />
                                    <button type="submit" class="cart-qty-btn" aria-label="เพิ่มจำนวน">+</button>
                                </form>
                            </div>
                        </div>

                        <div class="cart-item-total fw-bold text-brand fs-5">
                            @(isBuffet ? "รวมในบุฟเฟต์" : $"฿{rowTotal:N2}")
                        </div>
                    </div>
                }

                <div class="mt-3">
                    <a asp-controller="Home" asp-action="Menu" asp-route-tableId="@ViewBag.TableId"
                       class="btn btn-outline-danger w-100 rounded-pill fw-bold py-3">
                        <i class="bi bi-plus-circle-fill me-1"></i> สั่งรายการอาหารเพิ่ม
                    </a>
                </div>
            }
            else
            {
                <div class="text-center py-5 bg-white rounded-4 border shadow-sm my-2">
                    <i class="bi bi-basket3 fs-1 text-danger d-block mb-3"></i>
                    <h4 class="fw-bold text-dark">ยังไม่มีรายการอาหารในตะกร้า</h4>
                    <p class="text-muted">เลือกเมนูอาหารอีสานรสเด็ดที่คุณชื่นชอบแล้วกดเพิ่มลงตะกร้า</p>
                    <a asp-controller="Home" asp-action="Menu" asp-route-tableId="@ViewBag.TableId"
                       class="btn btn-brand rounded-pill px-4 py-2 fw-bold mt-2">
                        <i class="bi bi-journal-text me-1"></i> ไปเลือกดูเมนูอาหาร
                    </a>
                </div>
            }
        </div>

        <!-- ฝั่งขวา: สรุปคำสั่งซื้อ และ ข้อมูลการรับอาหาร -->
        <div class="col-lg-4">
            <form asp-controller="Home" asp-action="Payment" method="post">
                <input type="hidden" name="tableId" value="@ViewBag.TableId" />
                <div class="cart-summary-card">
                    <h5 class="fw-bold mb-3 text-dark d-flex align-items-center gap-2">
                        <i class="bi bi-receipt text-danger"></i> รายละเอียดการรับอาหาร
                    </h5>

                    @if (ViewBag.IsPreorder == true)
                    {
                        <div class="p-3 rounded-3 bg-danger bg-opacity-10 border border-danger border-opacity-25 mb-3">
                            <strong class="text-danger d-block mb-1"><i class="bi bi-bag-check-fill me-1"></i> สั่งล่วงหน้า · รับที่ร้าน</strong>
                            <small class="text-muted">ไม่มีบริการจัดส่ง กรุณาระบุเวลารับอาหารในวันนี้</small>
                        </div>
                        <div class="mb-4">
                            <label class="form-label small fw-bold text-dark" for="arriveTime">เวลาที่ต้องการมารับอาหาร</label>
                            <input type="time" id="arriveTime" name="arriveTime" class="form-control" min="@ViewBag.MinPickupTime" required />
                        </div>
                    }
                    else
                    {
                        <div class="p-3 rounded-3 bg-light border mb-3">
                            <span class="badge bg-danger rounded-pill px-2 py-1 mb-1">ทานที่ร้าน</span>
                            <div class="fw-bold text-dark fs-5">โต๊ะ @ViewBag.TableNumber</div>
                        </div>
                        <input type="hidden" name="arriveTime" value="-" />
                    }

                    @if (ViewBag.OrderError != null)
                    {
                        <div class="alert alert-danger rounded-3" role="alert">@ViewBag.OrderError</div>
                    }

                    <hr class="my-4">
                    
                    <h5 class="fw-bold mb-3 text-dark">สรุปยอดรวม</h5>
                    <div class="d-flex justify-content-between mb-2 text-muted">
                        <span>ค่าอาหาร</span>
                        <span class="fw-bold text-dark">฿@(isBuffet ? buffetTotalAmount : totalAmount)</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 text-muted">
                        <span>ค่าบริการ (Service Charge)</span>
                        <span class="fw-bold text-success">ฟรี ฿0</span>
                    </div>
                    
                    <hr class="my-3">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="fw-bold text-dark fs-5">ยอดรวมสุทธิ</span>
                        <span class="cart-total-price">฿@(isBuffet ? buffetTotalAmount : totalAmount)</span>
                    </div>

                    <button type="submit" class="btn btn-brand w-100 py-3 rounded-pill fw-bold fs-5 shadow"
                            @(Model != null && Model.Any() ? "" : "disabled")>
                        <i class="bi bi-credit-card-fill me-2"></i> ดำเนินการชำระเงิน
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
