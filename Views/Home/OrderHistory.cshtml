@model IEnumerable<IsanDer.Models.Order>
@{
    ViewData["Title"] = "ประวัติการสั่งซื้อ";
    int index = 0; // ตัวแปรสำหรับเช็กรายการแรก
}

<style>
    .order-card {
        background-color: white;
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 24px 30px;
        margin-bottom: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    /* กรอบสีฟ้าสำหรับรายการแรก */
    .order-card.selected {
        border: 2px solid var(--brand-green);
    }
    .order-price {
        color: var(--brand-red);
        font-weight: bold;
        font-size: 1.25rem;
    }
    /* สีสถานะต่างๆ */
    .status-success { color: #16a34a; font-weight: bold; font-size: 0.9rem; }
    .status-cancel { color: #dc2626; font-weight: bold; font-size: 0.9rem; }
    .status-pending { color: #eab308; font-weight: bold; font-size: 0.9rem; } /* สีเหลืองสำหรับรอดำเนินการ */
    
    .btn-details {
        background-color: var(--brand-green);
        color: white;
        border: none;
        border-radius: 6px;
        padding: 8px 24px;
        font-size: 0.9rem;
        transition: 0.2s;
    }
    .btn-details:hover {
        background-color: var(--brand-green-dark);
        color: white;
    }
</style>

<div class="container mt-5 pb-5" style="max-width: 1000px;">
    <h2 class="fw-bold mb-4">ประวัติการสั่งซื้อ</h2>

    @if (Model != null && Model.Any())
    {
        @foreach (var order in Model)
        {
            // ให้รายการแรก (ออเดอร์ล่าสุด) มีคลาส selected (กรอบสีฟ้า)
            string selectedClass = (index == 0) ? "selected" : "";
            
            <div class="order-card @selectedClass shadow-sm">
                <!-- ข้อมูลฝั่งซ้าย -->
                <div>
                    <!-- แสดงเลขบิลแบบมี 0 นำหน้าให้ดูสวยงาม เช่น ORD0001 -->
                    <h5 class="fw-bold mb-2">#ORD@(order.OrderID.ToString("D4"))</h5>
                    <p class="text-dark fw-bold mb-1" style="font-size: 0.9rem;">ร้าน: อีสาน เด้อ</p>
                    
                    <!-- แสดงรูปแบบการรับอาหารและวิธีชำระเงิน แทนรายการอาหารก่อน (รายการอาหารค่อยไปดูในปุ่มรายละเอียด) -->
                    <p class="text-muted mb-0" style="font-size: 0.85rem;">
                        @order.OrderType | ชำระเงิน: @order.PaymentMethod
                    </p>
                    @if (order.OrderType == "สั่งล่วงหน้า รับที่ร้าน")
                    {
                        <p class="text-muted mb-0" style="font-size: 0.85rem;">เวลารับอาหาร: @order.ArriveTime น.</p>
                    }
                    @if (order.DiningTable != null)
                    {
                        <p class="text-muted mb-0" style="font-size: 0.85rem;">โต๊ะ @order.DiningTable.TableNumber</p>
                    }
                </div>
                
                <!-- ข้อมูลฝั่งขวา -->
                <div class="d-flex align-items-center gap-5">
                    <div class="text-start">
                        <p class="text-muted mb-2" style="font-size: 0.85rem;">@order.OrderDate.ToString("dd MMM yyyy HH:mm")</p>
                        <p class="order-price mb-0">฿@order.TotalAmount.ToString("N2")</p>
                    </div>
                    
                    <div class="text-center" style="min-width: 110px;">
                        <!-- เช็กสถานะเพื่อเปลี่ยนสีข้อความ -->
                        @if (order.OrderStatus == "ยกเลิก")
                        {
                            <p class="status-cancel mb-2 text-start">@order.OrderStatus</p>
                        }
                        else if (order.OrderStatus == "เสร็จแล้ว" || order.OrderStatus == "สำเร็จ")
                        {
                            <p class="status-success mb-2 text-start">สำเร็จ ✓</p>
                        }
                        else
                        {
                            <p class="status-pending mb-2 text-start">@order.OrderStatus ⏳</p>
                        }
                        
                        <!-- ปุ่มดูรายละเอียด (เตรียมส่ง OrderID ไปยังหน้า OrderDetails) -->
                        <a asp-controller="Home" asp-action="OrderDetails" asp-route-id="@order.OrderID" class="btn btn-details text-decoration-none d-inline-block">ดูรายละเอียด</a>
                    </div>
                </div>
            </div>
            
            index++;
        }
    }
    else
    {
        <!-- กรณีที่ยังไม่เคยสั่งอาหารเลย -->
        <div class="alert bg-white text-center py-5 border border-light rounded-4 shadow-sm">
            <h5 class="text-muted mb-4">คุณยังไม่มีประวัติการสั่งอาหาร</h5>
            <a asp-controller="Home" asp-action="Menu" class="btn text-white px-5 py-3 rounded-pill fw-bold" style="background-color: var(--brand-red);">ไปสั่งอาหารกันเลย!</a>
        </div>
    }

</div>