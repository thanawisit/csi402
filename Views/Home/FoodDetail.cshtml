@model IsanDer.Models.Menu

@{
    ViewData["Title"] = Model.MenuName;
}

<div class="container mt-5 pb-5">
    <a asp-controller="Home" asp-action="Menu" asp-route-tableId="@ViewBag.TableId" class="text-danger text-decoration-none mb-4 d-inline-block">← กลับไปเมนูอาหาร</a>

    <div class="row g-4">
        <div class="col-md-6">
            @if (!string.IsNullOrWhiteSpace(Model.ImagePath))
            {
                <img src="@Model.ImagePath" alt="รูปเมนู @Model.MenuName"
                     style="width: 100%; height: 400px; object-fit: cover; border-radius: 16px; border: 1px solid var(--brand-red);" />
            }
            else
            {
                <div style="background-color: var(--brand-green-soft); height: 400px; border-radius: 16px; border: 1px solid var(--brand-red);"></div>
            }
        </div>
        
        <div class="col-md-6">
            <div class="p-4 bg-white shadow-sm rounded-4 border border-light h-100">
                <!-- ดึงชื่อและราคาจากฐานข้อมูล -->
                <h2 class="fw-bold mb-2">@Model.MenuName</h2>
                @if (ViewBag.TableId != null)
                {
                    <p class="text-muted">โต๊ะ @ViewBag.TableNumber</p>
                }
                <p class="text-muted mb-4">⭐ 4.8 · 120 รีวิว</p>
                
                <h3 class="fw-bold text-danger mb-4">฿@Model.Price</h3>
                
                @if (!string.Equals(Model.Status, "Available", StringComparison.OrdinalIgnoreCase) || Model.StockQuantity == 0)
                {
                    <div class="alert alert-secondary mb-0">เมนูนี้ปิดขายหรือสินค้าหมดแล้ว</div>
                }
                else
                {
                    <form asp-controller="Home" asp-action="AddToCart" method="post">
                        <input type="hidden" name="menuId" value="@Model.MenuId" />
                        <input type="hidden" name="tableId" value="@ViewBag.TableId" />
                        
                        <div class="mb-4">
                            <label class="fw-bold mb-2">จำนวน</label>
                            <div class="d-flex align-items-center">
                                <input type="number" name="qty" value="1" min="1" max="@Model.StockQuantity" class="form-control text-center me-3" style="width: 100px;" />
                            </div>
                        </div>

                        <button type="submit" class="btn btn-danger w-100 py-3 rounded-3 fw-bold fs-5">
                            เพิ่มลงรายการอาหาร
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>